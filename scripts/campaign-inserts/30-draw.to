            if(absorb<1){const pull=1-Math.pow(1-absorb,2);ctx.save();ctx.globalAlpha=1-pull;ctx.translate(0,-pull*28);drawAshWarg(warg.x,warg.y,warg.groundY,warg.facing,"sleep",elapsed,now,WARG_RENDER_SIZE*(1-pull*.7),false,false);ctx.restore();}
            if(!wargCardCollected)drawMagicalAnimalCard("Ash Warg",warg.x,warg.groundY,now,warg.modeStarted+350,dragonImage,{x:0,y:25,w:256,h:260},ASH_WARG_CARD.palette);
            continue;
          }
          ctx.save();ctx.shadowColor=hurtActive?"rgba(232,220,200,.9)":warg.howlUntil>now?"rgba(232,220,200,.55)":warg.angry?"rgba(138,58,50,.5)":"rgba(138,134,128,.25)";ctx.shadowBlur=hurtActive?18:warg.angry?12:6;
          drawAshWarg(warg.x,warg.y,warg.groundY,warg.facing,warg.mode,elapsed,now,WARG_RENDER_SIZE,hurtActive,warg.howlUntil>now);
          ctx.restore();
          const barW=82,barH=8,barX=warg.x-barW/2,barY=warg.y-72,ratio=Math.max(0,Math.min(1,warg.health/warg.maxHealth));
          ctx.save();ctx.textAlign="center";ctx.textBaseline="bottom";ctx.font="700 8px ui-monospace, SFMono-Regular, Menlo, monospace";ctx.lineWidth=3;ctx.strokeStyle="rgba(16,14,12,.9)";ctx.strokeText((warg.howlUntil>now?"HOWLING ":warg.angry?"ANGRY ":"")+"ASH WARG "+warg.health+" / "+warg.maxHealth,warg.x,barY-3);ctx.fillStyle=warg.angry?"#ffb19d":"#e8dcc8";ctx.fillText((warg.howlUntil>now?"HOWLING ":warg.angry?"ANGRY ":"")+"ASH WARG "+warg.health+" / "+warg.maxHealth,warg.x,barY-3);
          ctx.fillStyle="rgba(16,14,12,.9)";ctx.fillRect(barX-2,barY-2,barW+4,barH+4);ctx.fillStyle="#4a1c18";ctx.fillRect(barX,barY,barW,barH);ctx.fillStyle="#c8b8a0";ctx.fillRect(barX,barY,barW*ratio,barH);ctx.restore();
        }
      }
      if(map===6){
        const elapsed=now-emberWyrmling.modeStarted;
        if(emberWyrmling.health<=0){
          const frames=DRAGON_FRAMES.sleep;const frame=frames[3];
          const absorb=Math.min(1,Math.max(0,(elapsed-120)/760));
          if(absorb<1)drawEmberWyrmlingSprite(ctx,dragonImage,frame,emberWyrmling,now,WYRM_RENDER_SIZE*(1-absorb*.7));
          if(!wyrmCardCollected)drawMagicalAnimalCard("Ember Wyrmling",emberWyrmling.x,emberWyrmling.groundY,now,emberWyrmling.modeStarted+350,dragonImage,{x:0,y:25,w:256,h:260},EMBER_WYRLING_CARD.palette);
        }else{
          const frames=DRAGON_FRAMES[emberWyrmling.mode];
          let index=0;
          if(emberWyrmling.mode==="idle")index=Math.floor(elapsed/520)%2;
          else if(emberWyrmling.mode==="walk")index=Math.floor(elapsed/245)%frames.length;
          else if(emberWyrmling.mode==="run")index=Math.floor(elapsed/105)%frames.length;
          else if(emberWyrmling.mode==="fly")index=Math.floor(elapsed/130)%frames.length;
          else if(emberWyrmling.mode==="attack")index=Math.min(frames.length-1,Math.floor(elapsed/235));
          else index=Math.min(frames.length-1,3);
          drawEmberWyrmlingSprite(ctx,dragonImage,frames[index],emberWyrmling,now,WYRM_RENDER_SIZE);
          const barW=90,barH=9,barX=emberWyrmling.x-barW/2,barY=emberWyrmling.y-118,ratio=Math.max(0,Math.min(1,emberWyrmling.health/emberWyrmling.maxHealth));
          ctx.save();ctx.textAlign="center";ctx.textBaseline="bottom";ctx.font="700 9px ui-monospace, SFMono-Regular, Menlo, monospace";ctx.lineWidth=3;ctx.strokeStyle="rgba(20,8,4,.9)";ctx.strokeText((emberWyrmling.angry?"ANGRY ":"")+"EMBER WYRLING "+emberWyrmling.health+" / "+emberWyrmling.maxHealth,emberWyrmling.x,barY-3);ctx.fillStyle=emberWyrmling.angry?"#ffb19d":"#ffd2a0";ctx.fillText((emberWyrmling.angry?"ANGRY ":"")+"EMBER WYRLING "+emberWyrmling.health+" / "+emberWyrmling.maxHealth,emberWyrmling.x,barY-3);
          ctx.fillStyle="rgba(20,8,4,.9)";ctx.fillRect(barX-2,barY-2,barW+4,barH+4);ctx.fillStyle="#5a2014";ctx.fillRect(barX,barY,barW,barH);ctx.fillStyle="#e07030";ctx.fillRect(barX,barY,barW*ratio,barH);ctx.restore();
        }
      }
      drawDragon(now);drawJackals(now);drawCompanion(now);
