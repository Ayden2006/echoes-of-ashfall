      }else if(readyJackal&&collectInventoryItem(SUNSET_JACKAL_CARD)){
        jackalCardCollected=true;toggleEquippedItem(SUNSET_JACKAL_CARD.id);
        tone(640,.16,.024);window.setTimeout(()=>tone(980,.22,.018),90);
      }else if(map===5&&!wargCardCollected){
        const readyWarg=ashWargs.find(w=>w.health<=0&&now-w.modeStarted>900&&Math.abs(pl.x-w.x)<105&&Math.abs((pl.y+PH)-w.groundY)<85);
        if(readyWarg&&collectInventoryItem(ASH_WARG_CARD)){wargCardCollected=true;toggleEquippedItem(ASH_WARG_CARD.id);tone(640,.16,.024);window.setTimeout(()=>tone(980,.22,.018),90);}
      }else if(map===6&&!wyrmCardCollected&&emberWyrmling.health<=0&&now-emberWyrmling.modeStarted>900&&Math.abs(pl.x-emberWyrmling.x)<105&&Math.abs((pl.y+PH)-emberWyrmling.groundY)<85){
        if(collectInventoryItem(EMBER_WYRLING_CARD)){wyrmCardCollected=true;toggleEquippedItem(EMBER_WYRLING_CARD.id);tone(700,.16,.024);window.setTimeout(()=>tone(1040,.22,.018),90);}
      }
